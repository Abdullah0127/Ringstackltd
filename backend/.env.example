# MongoDB connection string (get this from https://www.mongodb.com/cloud/atlas)
MONGODB_URI=mongodb://localhost:27017/edm_lead_network

# Secret key used to sign JWTs. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-secret

# Port the Express server listens on (default: 5000)
PORT=5000

# URL of the frontend (used for CORS). Dev default:
CLIENT_URL=http://localhost:5173

# Node environment (development | production)
NODE_ENV=development